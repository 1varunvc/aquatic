#!/bin/bash
set -euo pipefail

###############################################################################
# Script Name : aquatic
# Description : Main router for the Aquatic CLI toolkit.
#
# Author      : Varun Chawla
# Created On  : March 21, 2026
# Last Updated: May 1, 2026
# Version     : 2.4.0
# Usage       : aquatic <command> [arguments]
# Requirements: macOS (for pbcopy), node, ffmpeg, gh, jq
###############################################################################

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CURRENT_VERSION=$(cat "$DIR/VERSION")

# --- UPDATE CHECK (non-blocking, periodic) ---
_aquatic_update_notify() {
    local STATE_DIR="$HOME/.aquatic"
    local LATEST_FILE="$STATE_DIR/latest_version"
    local CHECK_FILE="$STATE_DIR/last_update_check"

    mkdir -p "$STATE_DIR"

    # Show notification from previous check
    if [ -f "$LATEST_FILE" ]; then
        local LATEST
        LATEST=$(cat "$LATEST_FILE")
        if [ "$LATEST" != "$CURRENT_VERSION" ] && [ -n "$LATEST" ]; then
            echo "[INFO] Update available: $CURRENT_VERSION -> $LATEST (run 'brew upgrade aquatic')"
        fi
    fi

    # Background check if stale (older than 24h)
    if [ "${AQUATIC_NO_UPDATE_CHECK:-0}" != "1" ]; then
        local NOW
        NOW=$(date +%s)
        local LAST=0
        [ -f "$CHECK_FILE" ] && LAST=$(cat "$CHECK_FILE")
        if [ $((NOW - LAST)) -gt 86400 ]; then
            (
                LATEST=$(curl -sf "https://api.github.com/repos/varun-chawla/aquatic-cli/releases/latest" 2>/dev/null | grep '"tag_name"' | head -1 | cut -d'"' -f4 | tr -d 'v') || true
                date +%s > "$CHECK_FILE"
                if [ -n "${LATEST:-}" ] && [ "$LATEST" != "$CURRENT_VERSION" ]; then
                    echo "$LATEST" > "$LATEST_FILE"
                else
                    rm -f "$LATEST_FILE"
                fi
            ) &>/dev/null &
        fi
    fi
}

_aquatic_update_notify

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    --version|-v)
        echo "aquatic $CURRENT_VERSION"
        ;;
    slideshow)
        "$DIR/aquatic-slideshow.sh" "$@"
        ;;
    compress)
        "$DIR/aquatic-compress.sh" "$@"
        ;;
    tag)
        "$DIR/aquatic-platform-mm-tag.sh" "$@"
        ;;
    mute)
        "$DIR/aquatic-mute.sh" "$@"
        ;;
    trim)
        "$DIR/aquatic-trim.sh" "$@"
        ;;
    flash)
        "$DIR/aquatic-flash.sh" "$@"
        ;;
    commit-history)
        "$DIR/aquatic-commit-history.sh" "$@"
        ;;
    net-surcharges)
        node "$DIR/aquatic-platform-mm-net-surcharges.js" "$@"
        ;;
    dev)
        if [ "${AQUATIC_DEV:-0}" != "1" ]; then
            echo "[ERROR] Dev-only command. Set AQUATIC_DEV=1 to enable."
            exit 1
        fi

        DEV_NAME="${1:-}"
        DEV_FILE="$DIR/aquatic-dev-$DEV_NAME.js"

        if [ -z "$DEV_NAME" ] || [ ! -f "$DEV_FILE" ]; then
            echo "[ERROR] Dev snippet '$DEV_NAME' not found."
            echo "Available: mm-extract-module, mm-expand-module, mm-extract-csv"
            exit 1
        fi

        sanitize_sed() {
            printf '%s' "$1" | sed -e 's/[~&/\]/\\&/g'
        }

        if [ "$DEV_NAME" = "mm-expand-module" ]; then
            ICON=$(sanitize_sed "${2:-ui-expansion-icon}")
            sed "s~___EXPANSION_ICON___~$ICON~g" "$DEV_FILE" | pbcopy
            echo "[OK] Snippet '$DEV_NAME' copied to clipboard!"
            echo "     > Injected Icon: $ICON"

        elif [ "$DEV_NAME" = "mm-extract-csv" ]; then
            DL_XPATH=$(sanitize_sed "${2:-//tbody/tr/td[11]/a[2]}")
            SPINNER=$(sanitize_sed "${3:-div.ngx-spinner-overlay}")
            NEXT_BTN=$(sanitize_sed "${4:-def}")
            DELAY=$(sanitize_sed "${5:-1200}")
            sed -e "s~___DOWNLOAD_LINKS_XPATH___~$DL_XPATH~g" \
                -e "s~___SPINNER_SELECTOR___~$SPINNER~g" \
                -e "s~___NEXT_PAGE_XPATH___~$NEXT_BTN~g" \
                -e "s~___DELAY___~$DELAY~g" "$DEV_FILE" | pbcopy
            echo "[OK] Snippet '$DEV_NAME' copied to clipboard!"
            echo "     > Injected Download XPath: $DL_XPATH"

        elif [ "$DEV_NAME" = "mm-extract-module" ]; then
            SUITE=$(sanitize_sed "${2:-.suite-header}")
            CLASS_ROW=$(sanitize_sed "${3:-.class-row}")
            CLASS_LINK=$(sanitize_sed "${4:-.col-4.text-end a}")
            METHOD_ROW=$(sanitize_sed "${5:-.col-8 > .row}")
            METHOD_LINK=$(sanitize_sed "${6:-.col-7 a}")
            OWNER_ELEM=$(sanitize_sed "${7:-.col-3 bsr-test-ownership}")
            TEAM=$(sanitize_sed "${8:-mmPay}")
            sed -e "s~___SUITE_HEADER___~$SUITE~g" \
                -e "s~___CLASS_ROW___~$CLASS_ROW~g" \
                -e "s~___CLASS_LINK___~$CLASS_LINK~g" \
                -e "s~___METHOD_ROW___~$METHOD_ROW~g" \
                -e "s~___METHOD_LINK___~$METHOD_LINK~g" \
                -e "s~___OWNERSHIP_ELEM___~$OWNER_ELEM~g" \
                -e "s~___TEAM_NAME___~$TEAM~g" "$DEV_FILE" | pbcopy
            echo "[OK] Snippet '$DEV_NAME' copied to clipboard!"
            echo "     > Injected Suite Header: $SUITE"

        else
            cat "$DEV_FILE" | pbcopy
            echo "[OK] Snippet '$DEV_NAME' copied to clipboard!"
        fi
        ;;
    *)
        echo "=========================================================="
        echo "                   AQUATIC CLI TOOLKIT                    "
        echo "              v$CURRENT_VERSION"
        echo "=========================================================="
        echo "Usage: aquatic <command> [options]"
        echo ""
        echo "Commands:"
        echo "  slideshow      <file>... [--no-timestamps] [--output <name>]  - Build 1-FPS screenshot slideshow"
        echo "  compress       <file> [--fps <n>]                             - Convert video to specific FPS (default 30)"
        echo "  mute           <file> [--fps <n>]                             - Strip audio from video (default 30fps)"
        echo "  trim           <file> --start <t> --end <t> [--fps <n>]       - Compress and cut middle section"
        echo "  flash          <file> --start <t> --end <t> [--speed <n>] [--fps <n>] - Speed up a section"
        echo "  tag            <owner> <repo> <version> [--branch <b>]        - Tag a commit using GitHub CLI"
        echo "  commit-history [--tags <n>] [--commits <n>] [--branch <b>]    - Visualize Git commit history by tag"
        echo "  net-surcharges [dir]                                          - Parse CSVs and tally surcharge stats"
        echo "  dev            <name> [args...]                               - Copy dev-only JS snippet (AQUATIC_DEV=1)"
        echo ""
        echo "Global Options:"
        echo "  --version, -v  Show version"
        echo "  --help, -h     Show this help"
        echo ""
        echo "Set AQUATIC_NO_UPDATE_CHECK=1 to disable update notifications."
        echo "=========================================================="
        ;;
esac
