#!/bin/bash

###############################################################################
# Script Name : aquatic
# Description : Main router for the Aquatic CLI toolkit.
#
# Author      : Varun Chawla
# Created On  : March 21, 2026
# Last Updated: March 25, 2026
# Version     : 2.2
# Usage       : aquatic <command> [arguments]
# Requirements: macOS (for pbcopy), node, ffmpeg, gh, jq
###############################################################################

COMMAND=$1
shift

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "$COMMAND" in
    slideshow)
        "$DIR/aquatic-slideshow.sh" "$@"
        ;;
    compress)
        "$DIR/aquatic-compress.sh" "$@"
        ;;
    tag)
        "$DIR/aquatic-platform-mm-tag.sh" "$@"
        ;;
    mute)
        "$DIR/aquatic-mute.sh" "$@"
        ;;
    trim)
        "$DIR/aquatic-trim.sh" "$@"
        ;;
    commit-history)
        "$DIR/aquatic-commit-history.sh" "$@"
        ;;
    net-surcharges)
        node "$DIR/aquatic-platform-mm-net-surcharges.js" "$@"
        ;;
    snippet)
        SNIPPET_NAME=$1
        SNIPPET_FILE="$DIR/aquatic-snippet-platform-$SNIPPET_NAME.js"

        if [ ! -f "$SNIPPET_FILE" ]; then
            echo "[ERROR] Snippet '$SNIPPET_NAME' not found."
            echo "Available: mm-extract-module, mm-expand-module, mm-extract-csv"
            exit 1
        fi

        if [ "$SNIPPET_NAME" = "mm-expand-module" ]; then
            ICON="${2:-ui-expansion-icon}"
            sed "s~___EXPANSION_ICON___~$ICON~g" "$SNIPPET_FILE" | pbcopy
            echo "[OK] Snippet '$SNIPPET_NAME' copied to clipboard!"
            echo "     > Injected Icon: $ICON"

        elif [ "$SNIPPET_NAME" = "mm-extract-csv" ]; then
            DL_XPATH="${2:-//tbody/tr/td[11]/a[2]}"
            SPINNER="${3:-div.ngx-spinner-overlay}"
            NEXT_BTN="${4:-def}"
            DELAY="${5:-1200}"
            sed -e "s~___DOWNLOAD_LINKS_XPATH___~$DL_XPATH~g" \
                -e "s~___SPINNER_SELECTOR___~$SPINNER~g" \
                -e "s~___NEXT_PAGE_XPATH___~$NEXT_BTN~g" \
                -e "s~___DELAY___~$DELAY~g" "$SNIPPET_FILE" | pbcopy
            echo "[OK] Snippet '$SNIPPET_NAME' copied to clipboard!"
            echo "     > Injected Download XPath: $DL_XPATH"

        elif [ "$SNIPPET_NAME" = "mm-extract-module" ]; then
            SUITE="${2:-.suite-header}"
            CLASS_ROW="${3:-.class-row}"
            CLASS_LINK="${4:-.col-4.text-end a}"
            METHOD_ROW="${5:-.col-8 > .row}"
            METHOD_LINK="${6:-.col-7 a}"
            OWNER_ELEM="${7:-.col-3 bsr-test-ownership}"
            TEAM="${8:-mmPay}"
            sed -e "s~___SUITE_HEADER___~$SUITE~g" \
                -e "s~___CLASS_ROW___~$CLASS_ROW~g" \
                -e "s~___CLASS_LINK___~$CLASS_LINK~g" \
                -e "s~___METHOD_ROW___~$METHOD_ROW~g" \
                -e "s~___METHOD_LINK___~$METHOD_LINK~g" \
                -e "s~___OWNERSHIP_ELEM___~$OWNER_ELEM~g" \
                -e "s~___TEAM_NAME___~$TEAM~g" "$SNIPPET_FILE" | pbcopy
            echo "[OK] Snippet '$SNIPPET_NAME' copied to clipboard!"
            echo "     > Injected Suite Header: $SUITE"

        else
            cat "$SNIPPET_FILE" | pbcopy
            echo "[OK] Snippet '$SNIPPET_NAME' copied to clipboard!"
        fi
        ;;
    *)
        echo "=========================================================="
        echo "                   AQUATIC CLI TOOLKIT                    "
        echo "=========================================================="
        echo "Usage: aquatic <command> [args]"
        echo ""
        echo "Commands:"
        echo "  slideshow      [dir]                      - Build 1-FPS screenshot slideshow"
        echo "  compress       <dir> <file> [fps]         - Convert video to specific FPS (default 30)"
        echo "  mute           <dir> <file> [fps]         - Strip audio from video (default 30fps)"
        echo "  trim           <dir> <file> <start> <end> [fps] - Compress (default 7) and cut middle section"
        echo "  tag            <owner> <repo> <ver> [br]  - Tag a commit using GitHub CLI"
        echo "  commit-history [tags] [commits] [br]      - Visualize Git commit history by tag"
        echo "  net-surcharges [dir]                      - Parse CSVs and tally surcharge stats"
        echo "  snippet        <name> [args...]           - Copy a parameterized JS snippet to clipboard"
        echo "=========================================================="
        ;;
esac